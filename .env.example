# ===================================================================
# GRID — Docker Environment Template
# Copy this file to .env and configure your secrets before deployment
# ===================================================================

# Application Environment (development, staging, production)
DEPLOY_ENVIRONMENT=development
IMAGE_TAG=1.0.0
DOCKERHUB_USERNAME=grid_admin

# Port Allocations
# Spring Boot backend port (defaults to 8082 locally to prevent 8080 collision with Jenkins)
APP_PORT=8082
SERVER_PORT=8080

# Frontend development port
FRONTEND_PORT=5173

# Nginx production reverse proxy entry port
NGINX_PORT=8081

# Database Configuration (MySQL 8.x)
MYSQL_DATABASE=grid_db
MYSQL_USER=grid_user
MYSQL_PASSWORD=grid_pass
MYSQL_ROOT_PASSWORD=grid_root_pass
MYSQL_HOST=db
MYSQL_PORT=3306

# Spring Boot Datasource Connection
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/grid_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=grid_user
SPRING_DATASOURCE_PASSWORD=grid_pass
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Bootstrap Seed Data (Flyway V7 manages baseline seed data)
APP_BOOTSTRAP_SEED_DATA=false

# Jenkins CI/CD Credentials Identifiers
JENKINS_DOCKERHUB_CREDENTIAL_ID=dockerhub-credentials
JENKINS_GIT_CREDENTIAL_ID=github-credentials
